# ---------------------------------------------------------------------------
# LLM Performance & Cost Observatory - example environment configuration
#
# Copy this file to .env and fill in values ONLY if you want to enable the
# optional real-model or observability integrations. The project runs
# completely without any of these being set.
# ---------------------------------------------------------------------------

# Optional: only needed for real-mode Gemini benchmarking.
GOOGLE_API_KEY=

# Must be explicitly set to true to enable real API calls. Defaults to
# false, meaning the project runs in LOCAL_SIMULATION mode with zero
# network access and zero API keys required.
USE_REAL_MODE=false

# Optional: enable an LLM-as-judge quality evaluator (requires GOOGLE_API_KEY
# and USE_REAL_MODE=true). Never required.
ENABLE_LLM_JUDGE=false

# Optional: enable LangSmith tracing of benchmark runs. Never required.
ENABLE_LANGSMITH=false
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=llm-performance-observatory

# Reproducibility
RANDOM_SEED=42

# Quality evaluation
QUALITY_THRESHOLD=0.70
RELEVANCE_THRESHOLD=0.60
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Example / configurable pricing assumptions (USD per 1,000,000 tokens).
# These do NOT represent guaranteed real commercial pricing.
DEFAULT_INPUT_COST_PER_1M=0.50
DEFAULT_OUTPUT_COST_PER_1M=1.50

# Composite production score weights (should sum to 1.0)
QUALITY_WEIGHT=0.50
RELIABILITY_WEIGHT=0.20
LATENCY_WEIGHT=0.15
COST_WEIGHT=0.15
