# Copy this file to .env and fill in values if you want optional LLM features.
# The project runs fully without any of these set.

# Google Gemini API key. Only required if USE_LLM_GENERATION or
# USE_LLM_JUDGE is set to true below.
GOOGLE_API_KEY=

# Set to "true" to let the AnswerGenerator optionally call Gemini instead of
# the local deterministic extractive generator. Defaults to false.
USE_LLM_GENERATION=false

# Set to "true" to run the optional Gemini LLM-as-judge evaluator alongside
# the deterministic metrics. Defaults to false.
USE_LLM_JUDGE=false

# Configurable cost estimates (USD per 1,000,000 tokens). These are
# illustrative placeholders for the cost-estimation feature, NOT verified
# production pricing -- adjust to match whatever pricing you want to model.
INPUT_COST_PER_1M_TOKENS=0.075
OUTPUT_COST_PER_1M_TOKENS=0.30
